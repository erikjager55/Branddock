# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# Claude Code — per-worktree session-lock (session-guard hook), nooit committen
.claude-session.lock
/playwright-report
/e2e/test-results.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
backups/
lighthouse-report.json

# Local storage provider artefacts (AI-generated images / videos /
# uploads) — never belong in git. Use a real storage provider for prod.
public/uploads/

# Local-only one-shot experiment artefacts die niet in repo horen.
# Bestaande tracked experiment-rapporten in docs/experiments/ blijven
# tracked; deze patterns vangen alleen niet-gecommitte exploratory dumps.
scripts/experiments/gpt-image-2-retest-*
docs/experiments/*-gpt-image-2-retest.json

# LP fidelity baseline-recompute lokale backups (audit 2026-06-10)
scripts/dev/.backup-lp-fidelity-baseline-*.json

# Browser-smoke screenshots (artefacten, niet voor git)
test-screenshots/

# Branddocks eigen branddoc — bewust buiten git (besluit 2026-08-16): een
# 2,3 MB PDF die per versie ververst hoort niet permanent in de historie.
# Klant-branddocs in docs/ (WRA, DTS Ede) blijven wél tracked.
docs/Branddock branddoc*.pdf

# E2E-run-artefacten (content-sweep). Dit zijn PER-RUN outputs: elke run wijzigt ze,
# dus getrackt maken ze elke werkboom vies en vullen ze PR's met wisselende JSON en
# binaire screenshots. Per ongeluk mee-gecommit in #280 (git add -A); 2026-08-16 losgekoppeld.
campaign-generator-outcome.json
campaign-stall-step-*.png
e2e/content-sweep-results.json
e2e/playwright-report-content-sweep/

# Claude Design-sync (/design-sync). Gestagede converter-scripts + hun node_modules,
# gegenereerde bundel-output en machine-state. De duurzame set onder .design-sync/
# (config.json, NOTES.md, conventions.md, previews/, overrides/) wordt WÉL getrackt:
# die bevat de correcties die een volgende sync niet opnieuw hoeft af te leiden.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
