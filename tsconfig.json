{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // De previews in .design-sync importeren uit 'branddock-app' — de naam die
      // de design-sync-bundler aan de barrel geeft. Zonder deze mapping staan de
      // 34 previews buiten de typecheck en merkt niemand dat een preview een prop
      // gebruikt die niet meer bestaat.
      "branddock-app": ["./.design-sync/entry.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".design-sync/**/*.ts",
    ".design-sync/**/*.tsx"
  ],
  "exclude": ["node_modules", "integrations"]
}
